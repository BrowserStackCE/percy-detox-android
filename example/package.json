{
  "name": "percy-detox-example",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "postinstall": "patch-package",
    "check-env": "bash ../scripts/check-env.sh",
    "prebuild:android": "npm run -s check-env",
    "build:android": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug",
    "bs:upload": "bash ../scripts/bs-upload.sh android/app/build/outputs/apk/debug/app-debug.apk android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
    "test:detox:cloud": "detox test -c android.cloud.debug",
    "test:percy:cloud": "percy app:exec -- detox test -c android.cloud.debug",
    "test:percy:local": "percy app:exec -- detox test -c android.emu.debug",
    "test:percy:attached": "percy app:exec -- detox test -c android.att.debug",
    "test:e2e:cloud": "npm run build:android && UPLOAD=\"$(npm run -s bs:upload)\" && eval \"$UPLOAD\" && npm run test:percy:cloud"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@percy/cli": "^1.32.12",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/react": "^18.2.6",
    "detox": "npm:@browserstack/detox@20.51.3-cloud.1",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "percy-detox": "file:..",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
